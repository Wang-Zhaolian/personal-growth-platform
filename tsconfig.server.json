  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext", "lib": ["ES2022"],
    "types": ["node"], "skipLibCheck": true, "strict": true, "esModuleInterop": true, "forceConsistentCasingInFileNames": true,
    "outDir": "dist/server", "rootDir": "server", "sourceMap": true
